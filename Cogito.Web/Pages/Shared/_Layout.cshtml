<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
</head>

<body>
    <header class="container header">
        <span class="title">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="var(--color-theme)"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                <path d="M12 2v8" />
                <path d="m4.93 10.93 1.41 1.41" />
                <path d="M2 18h2" />
                <path d="M20 18h2" />
                <path d="m19.07 10.93-1.41 1.41" />
                <path d="M22 22H2" />
                <path d="m8 6 4-4 4 4" />
                <path d="M16 18a4 4 0 0 0-8 0" />
            </svg>
            <span>
                Cogito<span class="highlight">.</span>
            </span>
        </span>
        <nav>
            <ul>
                <li>
                    <a href="/">Entries</a>
                </li>
                <li>
                    <a href="/quotes">
                        quotes
                    </a>
                </li>
                <li>
                    <a href="/insights">
                        insights
                    </a>
                </li>
            </ul>
        </nav>
        <div class="login-container">
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script defer src="~/js/site.js" asp-append-version="true"></script>
    <script defer src="~/js/alpine-3.16.2.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>