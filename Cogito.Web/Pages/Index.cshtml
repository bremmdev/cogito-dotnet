@page
@model EntriesModel
@{
    ViewData["Title"] = "Cogito - Entries";
}

<div class="title-container">
    <h1>Entries</h1>
    <a class="button primary right" href="/entries/new">Create Entry</a>
</div>

<ul class="entries">
    @foreach (var entry in Model.Entries)
    {
        <li>
            <span class="flex-between">
                <h2 class="fit">@entry.Title</h2>
                <span class="relative sentiment-container">
                    <span class="mood">@(entry.Mood ?? "Unknown")</span>
                </span>
            </span>

            <span class="date">@entry.Date</span>
            <p class="content">@entry.Content</p>
        </li>
    }
</ul>