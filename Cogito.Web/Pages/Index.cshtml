@page
@model EntriesModel
@{
    ViewData["Title"] = "Cogito - Entries";
}

<div class="title-container">
    <h1>Entries</h1>
    <a class="button primary right" href="/entries/new">Create Entry</a>
</div>

<ul class="entries">
@foreach (var entry in Model.Entries)
{
        <li x-data="{ isExpanded: false }">
            <span class="flex-between">
                <h2 class="fit">@entry.Title</h2>
                <span class="relative sentiment-container">
                    <sentiment-icon sentiment="@entry.Sentiment" />
                    <span class="mood">@(entry.Mood ?? "Unknown")</span>
                </span>
            </span>

            <span class="date">@entry.Date</span>
            <p class="content" x-bind:class="{ 'expanded': isExpanded }">@entry.Content</p>
            <div class="flex">
                <button class="button inverted fit read-more" x-on:click="isExpanded = !isExpanded"
                    x-text="isExpanded ? 'Read less' : 'Read more'">
                </button>
            </div>
        </li>
    }
</ul>