@page
@model InsightsModel
@{
    ViewData["Title"] = "Cogito - Insights";
}

<h1>Insights</h1>

<div class="stats">
    <div class="stat">
        <span>@Model.TotalEntries</span>
        <span>Entries</span>
    </div>
    <div class="stat">
        <span>@Model.Positive</span>
        <span>Positive</span>
    </div>
    <div class="stat">
        <span>@Model.Neutral</span>
        <span>Neutral</span>
    </div>
    <div class="stat">
        <span>@Model.Negative</span>
        <span>Negative</span>
    </div>
</div>

<section class="insight-section">
    <h2>Writing streak</h2>
    <div class="streak">
        <span>@Model.CurrentStreak days</span>
        <span>Current streak</span>
    </div>
</section>
